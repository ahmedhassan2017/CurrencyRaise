<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: permit only user preferences and the last successful public quote. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="datastore/latest_rate.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="datastore/latest_rate.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
